# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# CHANNEL3_API_KEY: Channel3 Commerce inventory API key
CHANNEL3_API_KEY=MY_CHANNEL3_API_KEY

# PAYPAL_CLIENT_ID: PayPal Sandbox App Client ID
PAYPAL_CLIENT_ID=MY_PAYPAL_CLIENT_ID

# PAYPAL_SECRET: PayPal Sandbox App Secret
PAYPAL_SECRET=MY_PAYPAL_SECRET

# PAYPAL_BASE_URL: PayPal API Base URL
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
